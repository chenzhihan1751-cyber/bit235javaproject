<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file for BIT235 Assessment 2 Part A (Wiki Administrator Login).
  Student: Chen Zhihan  ID: S1580887
  Spring Boot parent brings in the dependency versions, so the starters below
  do not need an explicit version number.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- look the parent up in the local / remote Maven repository -->
    </parent>

    <groupId>au.edu.mp</groupId>
    <artifactId>wikiadminlogin</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>wikiadminlogin</name>
    <description>BIT235 Assessment 2 Part A - wiki administrator login</description>

    <properties>
        <!-- Java 21 is the toolchain used in the lab; Spring Boot 4 needs 17+. -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Thymeleaf renders the HTML views from src/main/resources/templates. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- The web MVC starter supplies Tomcat, DispatcherServlet and the
             @Controller / @GetMapping annotations used by this project. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Test starter: JUnit 5 plus AssertJ, used by AuthServiceTests. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Lets "mvn spring-boot:run" start the app and "mvn package"
                 produce an executable jar. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
